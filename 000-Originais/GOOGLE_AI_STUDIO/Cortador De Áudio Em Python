nstalação ANTES de iniciar a ferramenta principal\ninstalar_dependencias()\nfrom pydub import AudioSegment\n\n# \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n# ⚙️ ZONA DE CONFIGURAÇÃO\n# \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n\n# 1. Pasta onde o arquivo original está. \n# IMPORTANTE: No Windows, sempre deixe o \u0027r\u0027 antes das aspas (ex: r\"C:\\...\")\nPASTA_ORIGEM \u003d r\"C:\\Users\\Kevyn Lucas\\Downloads\"\n\n# 2. Nome do arquivo de áudio original (com a extensão)\nNOME_ARQUIVO_ORIGEM \u003d \"meu_audio.mp3\"\n\n# 3. Pasta onde os áudios cortados serão salvos\nPASTA_DESTINO \u003d r\"C:\\Users\\Kevyn Lucas\\Documents\\scripts\\saida_cortada\"\n\n# 4. Em quantas partes IGUAIS o áudio deve ser cortado?\nNUMERO_DE_PARTES \u003d 5\n\n# 5. Formato de saída desejado para os áudios cortados (ex: \u0027mp3\u0027, \u0027wav\u0027, \u0027ogg\u0027, \u0027flac\u0027)\nFORMATO_SAIDA \u003d \"mp3\"\n\n# \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u