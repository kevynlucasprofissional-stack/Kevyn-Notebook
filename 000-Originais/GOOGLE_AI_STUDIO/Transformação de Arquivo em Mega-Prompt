      }, {
        "text": "\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    organizer_id UUID REFERENCES users(id"
      }, {
        "text": ") ON DELETE CASCADE,\n    title VARCHAR(255) NOT NULL,\n    description TEXT,"
      }, {
        "text": "\n    duration_minutes INT DEFAULT 60,\n    status VARCHAR(50) DEFAULT \u0027open\u0027, \n    final_start_"
      }, {
        "text": "time TIMESTAMP WITH TIME ZONE,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n);\n\n-- 3"
      }, {
        "text": ". PARTICIPANTS: Fricção zero (Não exige email)\nCREATE TABLE participants (\n    id UUID PRIMARY KEY DEFAULT"
      }, {
        "text": " gen_random_uuid(),\n    meeting_id UUID REFERENCES meetings(id) ON DELETE CASCADE,\n    name"
      }, {
        "text": " VARCHAR(255) NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n);"
      }, {
        "text": "\n\n-- 4. AVAILABILITIES: Blocos de tempo marcados no Grid\nCREATE TABLE availabilities (\n    id UUID PRIMARY"
      }, {
        "text": " KEY DEFAULT gen_random_uuid(),\n    participant_id UUID REFERENCES participants(id) ON DELETE CASCADE,"
      }, {
        "text": "\n    start_time TIMESTAMP WITH TIME ZONE NOT NULL,\n    end_time TIMESTAMP WITH TIME ZONE NOT NULL,"
      }, {
        "text": "\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n);\n\nCREATE INDEX idx_availabilities_participant ON avail"
      }, {
        "text": "abilities(participant_id);\nCREATE INDEX idx_participants_meeting ON participants(meeting_id);\n```"
      }, {
        "text": "\n\n---\n\n# FLUXOS DE USUÁRIO\n\n**Fluxo do Organizador:**\n1. Faz Login/"
      }, {
        "text": "Cadastro.\n2. Acessa o Dashboard de Reuniões.\n3. Cria uma Nova Reunião (define pauta e"
