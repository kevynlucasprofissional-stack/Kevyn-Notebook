      }, {
        "text": "\u003c/source_ids\u003e\n      \u003cdependencias_conhecidas\u003efam_001\u003c/dependencias_"
      }, {
        "text": "conhecidas\u003e\n    \u003c/family\u003e\n  \u003c/source_family_registry\u003e\n\n  \u003cevidence_registry"
      }, {
        "text": "\u003e\n    \u003cevidence id\u003d\"ev_001\"\u003e\n      \u003csource_id\u003esrc_00"
      }, {
        "text": "1\u003c/source_id\u003e\n      \u003clocator\u003ePrólogo\u003c/locator\u003e\n      \u003crelation\u003esupports\u003c/relation\u003e\n      \u003cobservacao"
      }, {
        "text": "\u003eZaratustra desce da montanha após 10 anos, encontra o santo na floresta e perce"
      }, {
        "text": "be que ele não sabe que \"Deus está morto\".\u003c/observacao\u003e\n      \u003coportunidade_de_observacao\u003e"
      }, {
        "text": "nao_aplicavel\u003c/oportunidade_de_observacao\u003e\n    \u003c/evidence\u003e\n    \u003cevidence"
      }, {
        "text": " id\u003d\"ev_002\"\u003e\n      \u003csource_id\u003esrc_001\u003c/source_id"
      }, {
        "text": "\u003e\n      \u003clocator\u003ePrólogo\u003c/locator\u003e\n      \u003crelation\u003esupports\u003c/relation\u003e\n      \u003cobserv"
      }, {
        "text": "acao\u003eEnsina ao povo sobre o Super-homem, descrevendo o homem como uma corda sobre um abismo entre o animal e o super"
      }, {
        "text": "-homem.\u003c/observacao\u003e\n      \u003coportunidade_de_observacao\u003enao_aplicavel"
      }, {
        "text": "\u003c/oportunidade_de_observacao\u003e\n    \u003c/evidence\u003e\n    \u003cevidence id\u003d\"ev_0"
      }, {
        "text": "03\"\u003e\n      \u003csource_id\u003esrc_001\u003c/source_id\u003e\n      \u003clocator"
      }, {
        "text": "\u003eDiscurso: Das três transformações\u003c/locator\u003e\n      \u003crelation\u003esupports\u003c/relation\u003e\n      \u003cobservacao\u003eDescre"
      }, {
        "text": "ve a transformação do espírito em camelo (dever), leão (destruição do dever/liberdade) e criança (novo"
      }, {
        "text": " começo/criação).\u003c/observacao\u003e\n      \u003coportunidade_de_observacao\u003enao_aplicavel\u003c/"
      }, {
        "text": "oportunidade_de_observacao\u003e\n    \u003c/evidence\u003e\n    \u003cevidence id\u003d\"ev_00"
      }, {
        "text": "4\"\u003e\n      \u003csource_id\u003esrc_002\u003c/source_id\u003e\n      \u003clocator\u003e"
      }, {
        "text": "Resumo / Capítulo III\u003c/locator\u003e\n      \u003crelation\u003esupports\u003c/relation\u003e\n      \u003cobservacao\u003eJung interpreta a jornada de Z"
      }, {
        "text": "aratustra como uma alegoria do Processo de Individuação, onde o Super-homem equivale ao Self ("
      }, {
        "text": "totalidade) alcançado pela união de opostos (Apolíneo/Dionisíaco).\u003c/observacao\u003e\n      \u003coportun"
      }, {
        "text": "idade_de_observacao\u003enao_aplicavel\u003c/oportunidade_de_observacao\u003e\n    "
      }, {
        "text": "\u003c/evidence\u003e\n    \u003cevidence id\u003d\"ev_005\"\u003e\n      \u003csource_id\u003esrc_"
      }, {
        "text": "003\u003c/source_id\u003e\n      \u003clocator\u003eSeções 3, 5, 6\u003c/locator\u003e\n      \u003crelation\u003e"
      }, {
        "text": "supports\u003c/relation\u003e\n      \u003cobservacao\u003eO texto sugere que Zaratustra foi concebido estilística e filosoficamente como um \"anti"
      }, {
        "text": "-Parsifal\", contrapondo a \"inocência dos sentidos\" e o dionisíaco à compaixão"
      }, {
        "text": ", castidade e moral de redenção cristã promovidas por Wagner.\u003c/observacao\u003e\n      \u003coportunidade_de_observ"
      }, {
        "text": "acao\u003enao_aplicavel\u003c/oportunidade_de_observacao\u003e\n    \u003c/evidence\u003e\n    "
      }, {
        "text": "\u003cevidence id\u003d\"ev_006\"\u003e\n      \u003csource_id\u003esrc_001\u003c/source"
      }, {
        "text": "_id\u003e\n      \u003clocator\u003eA visão e do enigma / Da redenção\u003c/locator\u003e\n      \u003crelation"
      }, {
        "text": "\u003esupports\u003c/relation\u003e\n      \u003cobservacao\u003eZaratustra ensina a doutrina do Eterno Retorno e"
      }, {
        "text": " a redenção do passado transformando o \"Assim foi\" em \"Assim eu quis\" (amor fati).\u003c/observacao\u003e"
      }, {
        "text": "\n      \u003coportunidade_de_observacao\u003enao_aplicavel\u003c/oportunidade_de_"
      }, {
        "text": "observacao\u003e\n    \u003c/evidence\u003e\n    \u003cevidence id\u003d\"ev_007\"\u003e\n      \u003csource"
      }, {
        "text": "_id\u003esrc_001\u003c/source_id\u003e\n      \u003clocator\u003ePrólogo / O grito de socorro"
      }, {
        "text": "\u003c/locator\u003e\n      \u003crelation\u003esupports\u003c/relation\u003e\n      \u003cobservacao\u003eSente profundo nojo do \"último"
      }, {
        "text": " homem\" (que inventou a \"felicidade\" e pisca o olho) e luta contra o pecado da \""
      }, {
        "text": "compaixão\" ao ouvir o grito dos Homens Superiores.\u003c/observacao\u003e\n      \u003coportunidade_de_observacao\u003e"
      }, {
        "text": "nao_aplicavel\u003c/oportunidade_de_observacao\u003e\n    \u003c/evidence\u003e\n  \u003c/evidence"
      }, {
        "text": "_registry\u003e\n\n  \u003cclaim_registry\u003e\n    \u003cclaim id\u003d\"clm_001\" revision"
      }, {
        "text": "\u003d\"1\"\u003e\n      \u003cenunciado\u003eZaratustra anuncia a morte de Deus como a queda dos valores absolutos e"
      }, {
        "text": " da ordem cósmica transcendente.\u003c/enunciado\u003e\n      \u003cstatus_epistemico\u003eAUTORRELATO\u003c/"
